{
  "openapi": "3.0.0",
  "info": {
    "title": "Admin Portal API",
    "description": "Rest API for Admin Portal",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/"
    }
  ],
  "tags": [
    {
      "name": "auth"
    },
    {
      "name": "admin/reports"
    },
    {
      "name": "admin/roles"
    },
    {
      "name": "admin/users"
    }

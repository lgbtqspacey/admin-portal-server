  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logs the user in",
        "description": "Creates a new session in the database",
        "parameters": [
          {
            "name": "sessionDeviceOS",
            "description": "Operating system of the device the client is running on",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/auth/login/confirmation": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sends login confirmation",
        "description": "Confirms that the client has successfully logged in",
        "parameters": [
          {
            "name": "sessionToken",
            "description": "Token generated by the server",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sessionUserId",
            "description": "Id of the user",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sessionExpiration",
            "description": "Timestamp of when the session expires",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sessionDeviceOS",
            "description": "Operating system of the device the client is running on",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logs the user out",
        "description": "Deletes the session from the database",
        "parameters": [
          {
            "name": "sessionToken",
            "description": "Token generated by the server",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/auth/logout/{id}": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logs the user out of all devices",
        "description": "Deletes all sessions of the user from the database",
        "parameters": [
          {
            "name": "sessionToken",
            "description": "Token generated by the server",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/auth/sessions/{id}": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Returns all sessions of a user",
        "description": "Return all sessions of the user from the database",
        "parameters": [
          {
            "name": "sessionToken",
            "description": "Token generated by the server",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
